{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "roosycozy",
  "version": "1.0.92",
  "identifier": "co.roosycozy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "roosycozy",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/HyperCLOVAX-SEED-Text-Instruct-0.5B-q4_0.gguf": "models/HyperCLOVAX-SEED-Text-Instruct-0.5B-q4_0.gguf",
      "resources/models/hyperclovax_roosy_Q4_K_M.gguf": "models/hyperclovax_roosy_Q4_K_M.gguf"
    },
    "macOS": {
      "entitlements": "entitlements.macos.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0",
      "files": {
        "embedded.provisionprofile": "embedded.provisionprofile",
        "MacOS/sidecar/llama-sidecar-aarch64-apple-darwin": "binaries/llama-sidecar-aarch64-apple-darwin",
        "MacOS/sidecar/libggml-base.0.dylib": "binaries/libggml-base.0.dylib",
        "MacOS/sidecar/libggml-blas.0.dylib": "binaries/libggml-blas.0.dylib",
        "MacOS/sidecar/libggml-cpu.0.dylib": "binaries/libggml-cpu.0.dylib",
        "MacOS/sidecar/libggml-metal.0.dylib": "binaries/libggml-metal.0.dylib",
        "MacOS/sidecar/libggml-rpc.0.dylib": "binaries/libggml-rpc.0.dylib",
        "MacOS/sidecar/libggml.0.dylib": "binaries/libggml.0.dylib",
        "MacOS/sidecar/libllama.0.dylib": "binaries/libllama.0.dylib",
        "MacOS/sidecar/libmtmd.0.dylib": "binaries/libmtmd.0.dylib"
      }
    }
  }
}
