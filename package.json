{
  "name": "roosycozy",
  "private": true,
  "version": "1.0.92",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "tauri",
    "ci:ensure-model": "node ./scripts/ensure-bundled-model.mjs",
    "ci:ensure-windows-runtime": "node ./scripts/ensure-windows-runtime.mjs",
    "windows:portable": "tauri build --no-bundle --ci && node ./scripts/stage-windows-portable.mjs",
    "appstore:build": "npm run ci:ensure-model && tauri build --bundles app --config src-tauri/tauri.appstore.conf.json --no-sign --ci && zsh ./scripts/prepare-appstore-app.sh",
    "appstore:build:unsigned": "npm run ci:ensure-model && tauri build --bundles app --config src-tauri/tauri.appstore.conf.json --no-sign --ci",
    "appstore:pkg": "zsh ./scripts/build-appstore-pkg.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@twind/core": "^1.1.3",
    "@twind/preset-tailwind": "^1.1.4",
    "htm": "^3.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
